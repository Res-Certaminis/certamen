# Copy to .env (git-ignored). Both values come from Supabase → Project Settings → API Keys.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The *publishable* key (sb_publishable_...). Safe to ship to browsers; access is governed by row-level security.
# A legacy anon JWT also works. Never put the secret key (sb_secret_...) here.
VITE_SUPABASE_KEY=sb_publishable_YOUR-KEY
